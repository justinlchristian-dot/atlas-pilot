{
  "name": "atlas-pilot",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest --environment node tests --exclude tests/e2e/**",
    "test:run": "vitest run --environment node tests --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "tsc --noEmit && vitest run --environment node tests --exclude tests/e2e/** && next build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.2.7",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "1.57.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  }
}
